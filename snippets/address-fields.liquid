{%- comment -%}
  顧客住所フォームの入力欄。
  Usage: {% render 'address-fields', form: form, id: 'new' %}
{%- endcomment -%}
<div class="address-fields">
  <div class="form__row">
    <label for="AddressLastName_{{ id }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input type="text" id="AddressLastName_{{ id }}" name="address[last_name]" class="field" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
  <div class="form__row">
    <label for="AddressFirstName_{{ id }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input type="text" id="AddressFirstName_{{ id }}" name="address[first_name]" class="field" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="form__row">
    <label for="AddressCompany_{{ id }}">{{ 'customer.addresses.company' | t }}</label>
    <input type="text" id="AddressCompany_{{ id }}" name="address[company]" class="field" value="{{ form.company }}" autocomplete="organization">
  </div>
  <div class="form__row">
    <label for="AddressCountry_{{ id }}">{{ 'customer.addresses.country' | t }}</label>
    <select id="AddressCountry_{{ id }}" name="address[country]" class="field" data-address-country="{{ id }}" data-default="{{ form.country | default: 'Japan' }}">
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="form__row">
    <label for="AddressZip_{{ id }}">{{ 'customer.addresses.zip' | t }}</label>
    <input type="text" id="AddressZip_{{ id }}" name="address[zip]" class="field" value="{{ form.zip }}" autocomplete="postal-code">
  </div>
  <div class="form__row" id="AddressProvinceContainer_{{ id }}">
    <label for="AddressProvince_{{ id }}">{{ 'customer.addresses.province' | t }}</label>
    <select id="AddressProvince_{{ id }}" name="address[province]" class="field" data-default="{{ form.province }}"></select>
  </div>
  <div class="form__row">
    <label for="AddressCity_{{ id }}">{{ 'customer.addresses.city' | t }}</label>
    <input type="text" id="AddressCity_{{ id }}" name="address[city]" class="field" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="form__row">
    <label for="AddressAddress1_{{ id }}">{{ 'customer.addresses.address1' | t }}</label>
    <input type="text" id="AddressAddress1_{{ id }}" name="address[address1]" class="field" value="{{ form.address1 }}" autocomplete="address-line1">
  </div>
  <div class="form__row">
    <label for="AddressAddress2_{{ id }}">{{ 'customer.addresses.address2' | t }}</label>
    <input type="text" id="AddressAddress2_{{ id }}" name="address[address2]" class="field" value="{{ form.address2 }}" autocomplete="address-line2">
  </div>
  <div class="form__row">
    <label for="AddressPhone_{{ id }}">{{ 'customer.addresses.phone' | t }}</label>
    <input type="tel" id="AddressPhone_{{ id }}" name="address[phone]" class="field" value="{{ form.phone }}" autocomplete="tel">
  </div>
  <label class="checkbox">
    {{ form.set_as_default_checkbox }}
    {{ 'customer.addresses.set_default' | t }}
  </label>
</div>
