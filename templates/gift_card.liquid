{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- assign initial_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value, shop: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section">
      <div class="page-width page-width--narrow text-center gift-card">
        <h1 class="page-title">{{ shop.name }}</h1>
        <p>{{ 'gift_cards.issued.subtext' | t }}</p>
        <p class="gift-card__value">{{ gift_card.balance | money }}</p>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--sold-out">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%Y/%m/%d' -%}
          <p>{{ 'gift_cards.issued.expiration_date' | t: expires_on: expires_on }}</p>
        {%- endif -%}
        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        {%- if gift_card.pass_url -%}
          <p><a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a></p>
        {%- endif -%}
        <p>
          <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
          <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
        </p>
      </div>
    </main>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
