<section class="section customer">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'form', novalidate: 'novalidate' -%}
      {{ form.errors | default_errors }}
      <div class="form__row">
        <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="RegisterLastName" name="customer[last_name]" class="field" autocomplete="family-name" value="{{ form.last_name }}">
      </div>
      <div class="form__row">
        <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="RegisterFirstName" name="customer[first_name]" class="field" autocomplete="given-name" value="{{ form.first_name }}">
      </div>
      <div class="form__row">
        <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="RegisterEmail" name="customer[email]" class="field" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="form__row">
        <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="RegisterPassword" name="customer[password]" class="field" autocomplete="new-password" required>
      </div>
      <label class="checkbox">
        <input type="checkbox" name="customer[accepts_marketing]" value="true">
        {{ 'customer.register.accepts_marketing' | t }}
      </label>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
