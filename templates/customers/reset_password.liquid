<section class="section customer">
  <div class="page-width page-width--narrow">
    <h1 class="page-title">{{ 'customer.reset_password.title' | t }}</h1>
    <p>{{ 'customer.reset_password.subtext' | t }}</p>
    {%- form 'reset_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="form__row">
        <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" class="field" autocomplete="new-password">
      </div>
      <div class="form__row">
        <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" class="field" autocomplete="new-password">
      </div>
      <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
