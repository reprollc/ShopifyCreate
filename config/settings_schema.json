[
  {
    "name": "theme_info",
    "theme_name": "Create",
    "theme_version": "1.0.0",
    "theme_author": "Repro",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "カラー",
    "settings": [
      { "type": "color", "id": "color_background", "label": "背景色", "default": "#ffffff" },
      { "type": "color", "id": "color_text", "label": "テキスト", "default": "#1a1a1a" },
      { "type": "color", "id": "color_accent", "label": "アクセント（ボタンなど）", "default": "#1a1a1a" },
      { "type": "color", "id": "color_accent_text", "label": "アクセント上のテキスト", "default": "#ffffff" },
      { "type": "color", "id": "color_sale", "label": "セール価格", "default": "#c0392b" },
      { "type": "color", "id": "color_border", "label": "枠線", "default": "#e5e5e5" }
    ]
  },
  {
    "name": "タイポグラフィ",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "見出しフォント", "default": "playfair_display_n4" },
      { "type": "font_picker", "id": "font_body", "label": "本文フォント", "default": "noto_sans_japanese_n4" },
      {
        "type": "range",
        "id": "font_body_scale",
        "label": "本文サイズ",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "レイアウト",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "ページ最大幅",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "ボタンの角丸",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ]
  },
  {
    "name": "商品カード",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "画像の比率",
        "options": [
          { "value": "adapt", "label": "画像に合わせる" },
          { "value": "square", "label": "正方形" },
          { "value": "portrait", "label": "縦長 (3:4)" }
        ],
        "default": "square"
      },
      { "type": "checkbox", "id": "card_show_vendor", "label": "ブランド名を表示", "default": false },
      { "type": "checkbox", "id": "card_show_second_image", "label": "ホバー時に2枚目の画像を表示", "default": true },
      { "type": "checkbox", "id": "card_show_quick_view", "label": "ホバー時に「詳細を見る」ボタンを表示", "default": true },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "画像の表示方法",
        "options": [
          { "value": "contain", "label": "全体を表示（余白あり・トルソー写真向け）" },
          { "value": "cover", "label": "枠いっぱいに表示（切り抜きあり）" }
        ],
        "default": "contain"
      }
    ]
  },
  {
    "name": "ファビコン",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "ファビコン画像", "info": "32 x 32px 推奨" }
    ]
  },
  {
    "name": "SNS",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "placeholder": "https://instagram.com/..." },
      { "type": "text", "id": "social_x_link", "label": "X (Twitter)", "placeholder": "https://x.com/..." },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook", "placeholder": "https://facebook.com/..." },
      { "type": "text", "id": "social_line_link", "label": "LINE", "placeholder": "https://line.me/..." },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube", "placeholder": "https://youtube.com/..." }
    ]
  }
]
