<section class="section main-collection">
  <div class="page-width">
    <header class="collection-header">
      <h1 class="page-title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-header__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <form class="collection-toolbar" data-collection-filters>
        {%- if section.settings.enable_filtering -%}
          {%- for filter in collection.filters -%}
            <details class="filter">
              <summary class="filter__summary">
                {{ filter.label | escape }}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
              </summary>
              <div class="filter__panel">
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <ul class="filter__list">
                      {%- for value in filter.values -%}
                        <li>
                          <label class="filter__option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                            <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                            {{ value.label | escape }} <span class="filter__count">({{ value.count }})</span>
                          </label>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- when 'price_range' -%}
                    <div class="filter__price">
                      <label>
                        <span class="visually-hidden">{{ 'collections.filters.from' | t }}</span>
                        <input class="field" type="number" name="{{ filter.min_value.param_name }}" placeholder="0" min="0"
                          {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %}>
                      </label>
                      <span>〜</span>
                      <label>
                        <span class="visually-hidden">{{ 'collections.filters.to' | t }}</span>
                        <input class="field" type="number" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0"
                          {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %}>
                      </label>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        {%- endif -%}

        {%- if section.settings.enable_sorting -%}
          <div class="collection-toolbar__sort">
            <label for="SortBy" class="visually-hidden">{{ 'collections.sorting.title' | t }}</label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select name="sort_by" id="SortBy" class="field">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <noscript><button type="submit" class="button">{{ 'collections.filters.apply' | t }}</button></noscript>
      </form>

      {%- assign has_active_filters = false -%}
      {%- for filter in collection.filters -%}
        {%- if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value -%}
          {%- assign has_active_filters = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if has_active_filters -%}
        <p class="collection-toolbar__clear"><a href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collections.filters.clear_all' | t }}</a></p>
      {%- endif -%}

      <p class="collection-count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>

      {%- if collection.products.size == 0 -%}
        <p class="empty-state">{{ 'collections.empty' | t }}</p>
      {%- else -%}
        <ul class="product-grid" style="--columns-desktop: {{ section.settings.columns }};">
          {%- for product in collection.products -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "コレクション",
  "class": "section-main-collection",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "コレクションの説明を表示", "default": true },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "1ページあたりの商品数",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "列数（PC）",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "checkbox", "id": "enable_filtering", "label": "絞り込みを有効化", "default": true, "info": "Search & Discovery アプリでフィルターを設定できます" },
    { "type": "checkbox", "id": "enable_sorting", "label": "並び替えを有効化", "default": true }
  ]
}
{% endschema %}
