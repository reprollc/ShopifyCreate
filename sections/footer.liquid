<footer class="site-footer">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="site-footer__blocks">
        {%- for block in section.blocks -%}
          <div class="site-footer__block" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}<h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                <ul class="site-footer__menu">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}<h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}<h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- form 'customer', class: 'newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
                  {%- endif -%}
                  {%- if form.errors -%}
                    <p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                  {%- endif -%}
                  <div class="newsletter-form__row">
                    <label for="NewsletterEmail-{{ block.id }}" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
                    <input id="NewsletterEmail-{{ block.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.label' | t }}" class="field">
                    <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
                  </div>
                {%- endform -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign socials = 'instagram,x,facebook,line,youtube' | split: ','
    -%}
    <ul class="site-footer__social">
      {%- for s in socials -%}
        {%- assign key = 'social_' | append: s | append: '_link' -%}
        {%- if settings[key] != blank -%}
          <li>
            <a href="{{ settings[key] }}" target="_blank" rel="noopener" class="icon-button">
              <span class="visually-hidden">{{ s | capitalize }}</span>
              {% render 'icon', name: s %}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="site-footer__bottom">
      {%- if section.settings.show_localization -%}
        <div class="site-footer__localization">{% render 'localization-form', id: 'Footer' %}</div>
      {%- endif -%}
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="site-footer__policies">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "フッター",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "決済アイコンを表示", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "国/通貨セレクターを表示", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "メニュー",
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "ショップ" },
        { "type": "link_list", "id": "menu", "label": "メニュー", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "テキスト",
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "私たちについて" },
        { "type": "richtext", "id": "text", "label": "本文", "default": "<p>ショップの紹介文をここに入力してください。</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "メールマガジン",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "メールマガジン登録" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
