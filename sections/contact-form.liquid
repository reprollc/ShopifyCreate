<section class="section contact-form">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', class: 'form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'templates.contact.form.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form__row">
        <label for="ContactName">{{ 'templates.contact.form.name' | t }}</label>
        <input id="ContactName" class="field" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="form__row">
        <label for="ContactEmail">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
        <input id="ContactEmail" class="field" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
      <div class="form__row">
        <label for="ContactPhone">{{ 'templates.contact.form.phone' | t }}</label>
        <input id="ContactPhone" class="field" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="form__row">
        <label for="ContactBody">{{ 'templates.contact.form.comment' | t }}</label>
        <textarea id="ContactBody" class="field" name="contact[body]" rows="6">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "お問い合わせフォーム",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "お問い合わせ" }
  ],
  "presets": [{ "name": "お問い合わせフォーム" }]
}
{% endschema %}
