<section class="password">
  <div class="password__box">
    <h1 class="password__logo">
      {% render 'brand-logo' %}
      <span class="visually-hidden">{{ shop.name }}</span>
    </h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
      <div class="newsletter-form__row">
        <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" class="field" required placeholder="{{ 'newsletter.label' | t }}">
        <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
      </div>
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'general.password_page.login_link' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter-form__row">
          <label for="Password" class="visually-hidden">{{ 'general.password_page.password' | t }}</label>
          <input type="password" name="password" id="Password" class="field" autocomplete="current-password" placeholder="{{ 'general.password_page.password' | t }}">
          <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "パスワードページ",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
