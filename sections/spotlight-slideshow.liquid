<section class="section spotlight" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed | times: 1000 }}"
  aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
  <div class="page-width">
    <div class="spotlight__track">
      {%- for block in section.blocks -%}
        <div class="spotlight__slide{% if forloop.first %} is-active{% endif %}" data-slide aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ forloop.length }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="spotlight__media media media--portrait">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 45vw, 100vw', widths: '400, 600, 900, 1200' }}
            {%- else -%}
              {{ 'product-3' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <div class="spotlight__content">
            {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if block.settings.heading != blank -%}<h2 class="spotlight__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="spotlight__text rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link }}" class="link-arrow">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="spotlight__dots" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="spotlight__dot{% if forloop.first %} is-active{% endif %}" data-slide-to="{{ forloop.index0 }}"
            aria-label="{{ 'sections.slideshow.go_to' | t: index: forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ピックアップ・スライド",
  "class": "section-spotlight",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "label", "label": "スライドの名前（読み上げ用）", "default": "ピックアップ" },
    { "type": "checkbox", "id": "autoplay", "label": "自動で切り替える", "default": true },
    {
      "type": "range",
      "id": "speed",
      "label": "切り替え間隔",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "秒",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "スライド",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "PICK UP" },
        { "type": "text", "id": "heading", "label": "見出し（ブランド名など）", "default": "ブランド名" },
        { "type": "richtext", "id": "text", "label": "説明文", "default": "<p>注目のアイテムやブランドを紹介しましょう。</p>" },
        { "type": "text", "id": "link_label", "label": "リンクのラベル", "default": "もっと見る" },
        { "type": "url", "id": "link", "label": "リンク" }
      ]
    }
  ],
  "presets": [
    { "name": "ピックアップ・スライド", "blocks": [{ "type": "slide" }, { "type": "slide" }] }
  ]
}
{% endschema %}
