<section class="section lookbook-grid">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header section__header--center"><h2 class="section__heading">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <ul class="lookbook-grid__list" style="--columns-desktop: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <li class="lookbook-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="lookbook-grid__link">{%- endif -%}
          <div class="media media--{{ section.settings.image_ratio }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 800, 1000' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <p class="lookbook-grid__caption">{{ block.settings.caption | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "ルックブック",
  "class": "section-lookbook-grid",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し" },
    {
      "type": "range",
      "id": "columns",
      "label": "列数（PC）",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "画像の比率",
      "options": [
        { "value": "portrait", "label": "縦長 (3:4)" },
        { "value": "square", "label": "正方形" }
      ],
      "default": "portrait"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "画像",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像" },
        { "type": "text", "id": "caption", "label": "キャプション" },
        { "type": "url", "id": "link", "label": "リンク" }
      ]
    }
  ],
  "presets": [
    { "name": "ルックブック", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }] }
  ]
}
{% endschema %}
