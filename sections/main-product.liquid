{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}
<section class="section main-product" data-product-section>
  <div class="page-width main-product__grid">
    <div class="main-product__media">
      {%- if product.media.size > 0 -%}
        <div class="product-gallery product-gallery--{{ section.settings.gallery_layout }}">
          <div class="product-gallery__main" data-gallery-main>
            {%- assign featured = current_variant.featured_media | default: product.featured_media -%}
            {%- for media in product.media -%}
              <div class="product-gallery__slide media media--adapt" style="--ratio: {{ media.aspect_ratio | default: 1 }}"
                data-media-id="{{ media.id }}"{% unless media.id == featured.id %} hidden{% endunless %}>
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {{ media | image_url: width: 1600 | image_tag: sizes: '(min-width: 990px) 55vw, 100vw', widths: '550, 750, 1100, 1400, 1600', loading: 'eager' }}
                  {%- when 'video', 'external_video' -%}
                    {{ media | media_tag: image_size: '1100x', autoplay: false, loop: false, controls: true }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag: image_size: '1100x', reveal: 'interaction', toggleable: true }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
          {%- if product.media.size > 1 -%}
            <ul class="product-gallery__thumbs">
              {%- for media in product.media -%}
                <li>
                  <button type="button" class="product-gallery__thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb="{{ media.id }}"
                    aria-label="{{ 'products.product.media.view' | t: index: forloop.index }}">
                    {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
      {%- endif -%}
    </div>

    <div class="main-product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="main-product__vendor" {{ block.shopify_attributes }}>{{ product.vendor | link_to_vendor }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="main-product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div class="main-product__price" data-product-price {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant %}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="main-product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'specs' -%}
            <div class="main-product__specs" {{ block.shopify_attributes }}>
              {% render 'product-specs', product: product, type: 'details', block: block %}
            </div>

          {%- when 'measurements' -%}
            <div class="main-product__specs" {{ block.shopify_attributes }}>
              {% render 'product-specs', product: product, type: 'measurements', block: block %}
            </div>

          {%- when 'text' -%}
            <div class="main-product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__title">{{ block.settings.heading | escape }}</summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>

          {%- when 'buy_buttons' -%}
            <div class="main-product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <fieldset class="product-option">
                      <legend class="product-option__label">{{ option.name | escape }}</legend>
                      <div class="product-option__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                          <input type="radio" class="product-option__input visually-hidden" id="{{ input_id }}"
                            name="option{{ option.position }}" value="{{ value | escape }}" data-option-input
                            {% if option.selected_value == value %}checked{% endif %}>
                          <label for="{{ input_id }}" class="product-option__pill{% unless value.available %} is-unavailable{% endunless %}">{{ value | escape }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}

                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                {%- if block.settings.show_quantity -%}
                  <div class="quantity-field">
                    <label for="Quantity-{{ section.id }}" class="product-option__label">{{ 'products.product.quantity' | t }}</label>
                    <div class="quantity" data-quantity>
                      <button type="button" class="quantity__button" data-quantity-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
                      <input id="Quantity-{{ section.id }}" class="quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                      <button type="button" class="quantity__button" data-quantity-plus aria-label="{{ 'products.product.quantity_increase' | t }}">&plus;</button>
                    </div>
                  </div>
                {%- endif -%}

                <p class="form-message form-message--error" data-form-error hidden></p>

                <button type="submit" name="add" class="button button--full" data-add-to-cart
                  {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-to-cart-text>
                    {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product-form__dynamic">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'question' -%}
            {%- liquid
              assign question_url = routes.root_url | append: 'pages/contact'
              if block.settings.page != blank
                assign question_url = block.settings.page.url
              endif
            -%}
            <a href="{{ question_url }}?product={{ product.title | url_encode }}" class="button button--secondary button--full button--small" {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }}
            </a>

          {%- when 'share' -%}
            <div class="main-product__share" {{ block.shopify_attributes }}>
              <button type="button" class="link-button" data-share-url="{{ request.origin }}{{ product.url }}" data-share-title="{{ product.title | escape }}">
                {{ 'products.product.share' | t }}
              </button>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": {{ product.variants | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "strings": {
        "addToCart": {{ 'products.product.add_to_cart' | t | json }},
        "soldOut": {{ 'products.product.sold_out' | t | json }},
        "unavailable": {{ 'products.product.unavailable' | t | json }}
      }
    }
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "商品詳細",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "画像ギャラリーの配置",
      "options": [
        { "value": "thumbs-left", "label": "サムネイルを左に縦並び" },
        { "value": "thumbs-bottom", "label": "サムネイルを下に横並び" }
      ],
      "default": "thumbs-left"
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "ブランド名", "limit": 1 },
    { "type": "title", "name": "商品名", "limit": 1 },
    { "type": "price", "name": "価格", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "購入ボタン",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "数量選択を表示", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "スピードチェックアウトボタンを表示", "default": true }
      ]
    },
    { "type": "description", "name": "商品説明", "limit": 1 },
    {
      "type": "specs",
      "name": "商品詳細（表）",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "商品詳細" },
        { "type": "header", "content": "コンディションのランクの説明" },
        { "type": "paragraph", "content": "メタフィールド「コンディション」に入力したランクの横に、この説明が表示されます" },
        { "type": "text", "id": "rank_s", "label": "S", "default": "新品・未使用に近い状態" },
        { "type": "text", "id": "rank_a", "label": "A", "default": "目立つ傷や汚れのない美品" },
        { "type": "text", "id": "rank_ab", "label": "AB", "default": "多少の使用感はあるものの、良好な状態" },
        { "type": "text", "id": "rank_b", "label": "B", "default": "使用感や小さな傷・汚れがある状態" },
        { "type": "text", "id": "rank_c", "label": "C", "default": "目立つ傷・汚れ・ダメージがある状態" }
      ]
    },
    {
      "type": "measurements",
      "name": "サイズ（実寸の表）",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "サイズ（実寸）" },
        { "type": "text", "id": "note", "label": "注記", "default": "平置きで測った実寸です。多少の誤差はご了承ください。" }
      ]
    },
    {
      "type": "text",
      "name": "テキスト",
      "settings": [{ "type": "richtext", "id": "text", "label": "テキスト", "default": "<p>テキストを入力</p>" }]
    },
    {
      "type": "collapsible",
      "name": "折りたたみ",
      "settings": [
        { "type": "text", "id": "heading", "label": "見出し", "default": "配送について" },
        { "type": "richtext", "id": "content", "label": "内容", "default": "<p>ご注文から3〜5営業日以内に発送いたします。</p>" },
        { "type": "page", "id": "page", "label": "ページの内容を表示" }
      ]
    },
    {
      "type": "question",
      "name": "問い合わせボタン",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "ラベル", "default": "この商品について問い合わせる" },
        { "type": "page", "id": "page", "label": "問い合わせページ", "info": "未設定の場合は /pages/contact に移動します。商品名が問い合わせ内容に自動入力されます" }
      ]
    },
    { "type": "share", "name": "シェア", "limit": 1 }
  ]
}
{% endschema %}
