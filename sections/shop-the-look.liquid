{%- assign featured = section.settings.product -%}
<section class="section shop-the-look">
  <div class="page-width shop-the-look__grid{% if section.settings.reverse %} shop-the-look__grid--reverse{% endif %}">
    <div class="shop-the-look__look media media--portrait">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 100vw', widths: '400, 600, 800, 1200' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="shop-the-look__product">
      {%- if section.settings.heading != blank -%}
        <p class="eyebrow">{{ section.settings.heading | escape }}</p>
      {%- endif -%}
      {%- if featured != blank -%}
        <a href="{{ featured.url }}" class="shop-the-look__product-media media media--square">
          {%- if featured.featured_media -%}
            {{ featured.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 60vw', widths: '300, 500, 800' }}
          {%- endif -%}
        </a>
        {%- if settings.card_show_vendor and featured.vendor != blank -%}
          <p class="product-card__vendor">{{ featured.vendor | escape }}</p>
        {%- endif -%}
        <h3 class="shop-the-look__title">{{ featured.title | escape }}</h3>
        {% render 'price', product: featured %}
        <a href="{{ featured.url }}" class="button button--dark">{{ section.settings.button_label | escape }}</a>
      {%- else -%}
        <div class="shop-the-look__product-media media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        <h3 class="shop-the-look__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
        <span class="button button--dark" aria-disabled="true">{{ section.settings.button_label | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ルックから買う",
  "class": "section-shop-the-look",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "着用・ルック画像" },
    { "type": "product", "id": "product", "label": "紹介する商品" },
    { "type": "text", "id": "heading", "label": "小見出し", "default": "SHOP THE LOOK" },
    { "type": "text", "id": "button_label", "label": "ボタンのラベル", "default": "この商品を見る" },
    { "type": "checkbox", "id": "reverse", "label": "画像と商品を左右入れ替える", "default": false }
  ],
  "presets": [{ "name": "ルックから買う" }]
}
{% endschema %}
