<section class="section main-blog">
  <div class="page-width">
    <h1 class="page-title">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 9 -%}
      <ul class="article-grid">
        {%- for article in blog.articles -%}
          <li>
            <article class="article-card">
              <a href="{{ article.url }}">
                <div class="media media--landscape">
                  {%- if article.image -%}
                    {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 800' }}
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
                  {%- endif -%}
                </div>
                <time class="article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'date' }}</time>
                <h2 class="article-card__title">{{ article.title | escape }}</h2>
                <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 100 }}</p>
              </a>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "ブログ",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
