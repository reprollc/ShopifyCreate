{%- if section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'sections.announcement.label' | t }}"
    style="--ab-bg: {{ section.settings.background }}; --ab-text: {{ section.settings.text_color }};">
    <div class="page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "お知らせバー",
  "class": "section-announcement-bar",
  "settings": [
    { "type": "text", "id": "text", "label": "テキスト", "default": "5,000円以上のご購入で送料無料" },
    { "type": "url", "id": "link", "label": "リンク" },
    { "type": "color", "id": "background", "label": "背景色", "default": "#1f3a5f" },
    { "type": "color", "id": "text_color", "label": "文字色", "default": "#ffffff" }
  ],
  "presets": [{ "name": "お知らせバー" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
